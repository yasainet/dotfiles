+// Outside zh-CN, Bing links results through bing.com/ck/a click tracking; the
+// real target is base64url-encoded in the `u=a1...` parameter.
+function unwrapBingRedirect(href) {
+  const m = href.replace(/&amp;/g, "&").match(/^https?:\/\/www\.bing\.com\/ck\/a\?.*?[?&]u=a1([A-Za-z0-9_-]+)/);
+  if (!m) return href;
+  try {
+    const target = Buffer.from(m[1], "base64url").toString("utf8");
+    return /^https?:\/\//.test(target) ? target : href;
+  } catch {
+    return href;
+  }
+}
