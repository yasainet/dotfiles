[user]
	name = yasainet
	email = mail@yasainet.com

[init]
	defaultBranch = main

[core]
	ignorecase = false

[color]
	ui = auto

[push]
	default = current

[pull]
	ff = only

[merge]
	commit = no

[pager]
	branch = false
	tag = false

[ghq]
	root = ~/ghq

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
	username = yasainet

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
