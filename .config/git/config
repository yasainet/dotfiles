[user]
	name = yasainet
	email = mail@yasainet.com

[init]
	defaultBranch = main

[core]
	ignorecase = false

[color]
	ui = auto

[push]
	default = current

[pull]
	ff = only

[pager]
	branch = false
	tag = false

[ghq]
	root = ~/ghq

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
	username = yasainet

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[url "git@github.com:"]
	insteadOf = https://github.com/

[credential "http://localhost:3030"]
	helper = 
	helper = !tea login helper

[includeIf "gitdir:~/ghq/localhost/"]
	path = ~/.local/share/gitea/gitconfig

[includeIf "gitdir:~/ghq/localhost:3030/"]
	path = ~/.local/share/gitea/gitconfig

