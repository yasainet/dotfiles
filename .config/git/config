[user]
	name = yasainet
	email = mail@yasainet.com

[init]
	defaultBranch = main

[core]
	ignorecase = false

[color]
	ui = auto

[push]
	default = current

[pull]
	ff = only

[pager]
	branch = false
	tag = false

[ghq]
	root = ~/ghq

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[url "git@github.com:"]
	insteadOf = https://github.com/

[url "git@gist.github.com:"]
	insteadOf = https://gist.github.com/

[url "ssh://git@localhost:2222/"]
	insteadOf = http://localhost:3030/

[includeIf "gitdir:~/ghq/localhost/"]
	path = ~/.local/share/gitea/gitconfig

[includeIf "gitdir:~/ghq/localhost:3030/"]
	path = ~/.local/share/gitea/gitconfig
