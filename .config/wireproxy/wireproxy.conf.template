# wireproxy: userspace WireGuard -> local SOCKS5
# Real file: ~/.local/share/wireproxy/wireproxy.conf (generated by install.sh)
#
# mullvad.conf: download from https://mullvad.net/account -> WireGuard configuration
#   (Platform: Linux, Multihop: off, Port: 51820). Never commit it.

WGConfig = __HOME__/.local/share/wireproxy/mullvad.conf

[Socks5]
BindAddress = 127.0.0.1:1080
